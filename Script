    let estatus = rowData[mapa["Estatus"]];
    let responsable = rowData[mapa["Responsable"]];

    let estatusLimpio = estatus ? estatus.toString().trim() : "";
    let nombreRespLimpio = responsable ? responsable.toString().trim() : "";
    let correoAsignado = config.ejecutivos[nombreRespLimpio];

    // La condición mágica: El estatus es de cierre Y el correo asignado es igual al mío
    if (config.cierre.includes(estatusLimpio) && correoAsignado === correoUsuarioActual) {
      filasAArchivar.push(rowData);
      indicesABorrar.push(startRow + i);
    }
  }

  if (filasAArchivar.length > 0) {
    let datosColA = sheetHistorial.getRange("A:A").getValues();
    let ultimaFilaReal = 1;

    for (let k = datosColA.length - 1; k >= 0; k--) {
      if (datosColA[k][0] !== "") {
        ultimaFilaReal = k + 1;
        break;
      }
    }

    // Pegamos usando la cantidad de columnas dinámicas (numColumnas)
    sheetHistorial.getRange(ultimaFilaReal + 1, 1, filasAArchivar.length, numColumnas).setValues(filasAArchivar);

    // Borramos de abajo hacia arriba de forma segura
    for (let j = indicesABorrar.length - 1; j >= 0; j--) {
      sheetPendientes.deleteRow(indicesABorrar[j]);
    }

    registrarEnLog("Mantenimiento", "Usuario", `Se archivaron ${filasAArchivar.length} tareas propias.`, `Archivado Individual ejecutado por: ${correoUsuarioActual}`);
    SpreadsheetApp.getUi().alert(`✅ ¡Tu limpieza está lista!\nSe movieron ${filasAArchivar.length} de tus tareas cerradas al Historial.`);
  } else {
    SpreadsheetApp.getUi().alert("No tienes tareas 'Cerradas' listas para archivar.");
  }
}


/**
 * 🌐 CREADOR DE TAREAS REMOTAS (Sheets -> Tasks)
 * Usa exclusivamente ID TAREA REMOTO y valida el correo E6.
 */
function sincronizarTareasRemotas() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName("Tareas Pendientes");
  if (!sheet) return;

  const config = obtenerConfiguracion(); 
  const miListaId = obtenerListaTareasId(); 
  const correoUsuarioActual = Session.getActiveUser().getEmail(); // <-- Saber quién presiona el botón
  
  if (!config || !miListaId) return;

  const mapa = obtenerMapaColumnas(sheet); 
  const startRow = 3; 
  const lastRow = sheet.getLastRow();
  if (lastRow < startRow) return;

  const data = sheet.getRange(startRow, 1, lastRow - startRow + 1, sheet.getLastColumn()).getValues();

  for (let i = 0; i < data.length; i++) {
    let rowData = data[i];
    let currentRow = startRow + i;

    let tipo = rowData[mapa["Tipo"]];          
    let aseguradora = rowData[mapa["Aseguradora"]];   
    let fechaIngreso = rowData[mapa["Fecha de ingreso a bitacora (m/d/a)"]];  
    let estatus = rowData[mapa["Estatus"]];       
    let contratante = rowData[mapa["Contratante"]];
    let agente = rowData[mapa["Agente"]];
    let descripcion = rowData[mapa["Descripcion y comentarios"]];   
    let fechaVencimiento = rowData[mapa["Prox. Seguimiento"]]; 
    let idTareaRemoto = rowData[mapa["ID TAREA REMOTO"]]; // <-- Buscamos en el carril correcto     
    let asignacionRemota = rowData[mapa["Asignacion remota"]];

    let estatusLimpio = estatus ? estatus.toString().trim() : "";
    let esRemoto = (asignacionRemota === true || asignacionRemota === "TRUE" || asignacionRemota === "true");

    // CADENERO: Es remoto + Soy el usuario remoto autorizado + Estatus activo remoto + NO tengo ID remoto
    if (esRemoto && correoUsuarioActual === config.correoRemoto && config.activosRemoto.includes(estatusLimpio) && !idTareaRemoto) {
      
      let fechaFormat = "";
      if (fechaIngreso instanceof Date && !isNaN(fechaIngreso)) {
        const meses = ["Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic"];
        fechaFormat = ` (${fechaIngreso.getDate()} ${meses[fechaIngreso.getMonth()]})`;
      }
      
      let partesTitulo = ["🌐 REMOTO", tipo, aseguradora, contratante, agente].filter(Boolean).join(" - ");
      let titulo = `${partesTitulo}${fechaFormat}`;
      
      let nuevaTarea = { 
        title: titulo, 
        notes: descripcion ? descripcion.toString() : "" 
      };

      if (fechaVencimiento instanceof Date && !isNaN(fechaVencimiento)) {
        nuevaTarea.due = new Date(fechaVencimiento.getTime() - (fechaVencimiento.getTimezoneOffset() * 60000)).toISOString();
      }

      try {
        let tareaCreada = Tasks.Tasks.insert(nuevaTarea, miListaId);
        // Escribimos en el carril correcto: ID TAREA REMOTO
        sheet.getRange(currentRow, mapa["ID TAREA REMOTO"] + 1).setValue(tareaCreada.getId());
        registrarEnLog(tipo, "Usuario Remoto", descripcion, "Nueva tarea REMOTA enviada a Google Tasks");
      } catch (e) {
        console.log("Error al crear tarea remota en fila " + currentRow + ": " + e.message);
      }
    }
  }
}

/**
 * 🌐 EL SUPERVISOR REMOTO (Tasks -> Sheets)
 * Lee ID TAREA REMOTO y valida la identidad del correo en E6.
 */
function sincronizarTasksASheetsRemotas() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName("Tareas Pendientes");
  if (!sheet) return;

  const config = obtenerConfiguracion();
  const miListaId = obtenerListaTareasId();
  const correoUsuarioActual = Session.getActiveUser().getEmail(); // <-- Seguridad
  
  if (!config || !miListaId) return;

  const mapa = obtenerMapaColumnas(sheet);
  const startRow = 3; 
  const lastRow = sheet.getLastRow();
  if (lastRow < startRow) return;

  const numColumnas = sheet.getLastColumn();
  const data = sheet.getRange(startRow, 1, lastRow - startRow + 1, numColumnas).getValues();

  for (let i = 0; i < data.length; i++) {
    let rowData = data[i];
    let currentRow = startRow + i;

    let tipo = rowData[mapa["Tipo"]];        
    let estatus = rowData[mapa["Estatus"]];     
    let descripcion = rowData[mapa["Descripcion y comentarios"]]; 
    let idTareaRemoto = rowData[mapa["ID TAREA REMOTO"]]; // <-- Carril remoto
    let asignacionRemota = rowData[mapa["Asignacion remota"]];

    let estatusLimpio = estatus ? estatus.toString().trim() : "";
    let esRemoto = (asignacionRemota === true || asignacionRemota === "TRUE" || asignacionRemota === "true");

    let esActivo = config.activosRemoto.includes(estatusLimpio);
    let esCerrado = config.cierreRemoto.includes(estatusLimpio);

    // CADENERO: Es remoto + Soy el usuario autorizado + Tiene ID Remoto + Estatus válido
    if (esRemoto && correoUsuarioActual === config.correoRemoto && idTareaRemoto && (esActivo || esCerrado)) {
      try {
        let tareaEnNube = Tasks.Tasks.get(miListaId, idTareaRemoto);
        
        if (esActivo && tareaEnNube.status === "completed") {
          let estatusNuevo = config.cierreRemoto[0] || "Cerrado"; 
          sheet.getRange(currentRow, mapa["Estatus"] + 1).setValue(estatusNuevo);
          sheet.getRange(currentRow, mapa["FECHA DE TÉRMINO"] + 1).setValue(new Date());
          registrarEnLog(tipo, "Usuario Remoto", descripcion, `Tarea remota completada. Actualizada a ${estatusNuevo}.`);
        }
        else if (esCerrado && tareaEnNube.status === "needsAction") {
          let estatusReabierto = config.activosRemoto[0] || "Pendiente";
          sheet.getRange(currentRow, mapa["Estatus"] + 1).setValue(estatusReabierto); 
          sheet.getRange(currentRow, mapa["FECHA DE TÉRMINO"] + 1).clearContent(); 
          registrarEnLog(tipo, "Usuario Remoto", descripcion, `Tarea remota REABIERTA. Estatus devuelto a ${estatusReabierto}.`);
        }
      } catch (e) {
        console.log(`⚠️ Error al revisar tarea remota ${idTareaRemoto} en fila ${currentRow}: ${e.message}`);
      }
    }
  }
}
