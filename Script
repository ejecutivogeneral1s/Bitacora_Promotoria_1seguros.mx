/**
 * GATILLO AUTOMÁTICO (VERSIÓN DINÁMICA E INMUNE A CAMBIOS DE COLUMNAS)
 */
function onEdit(e) {
  if (!e || !e.range) return;

  const nombreHojaObjetivo = "Tareas Pendientes";
  const hojaEditada = e.source.getActiveSheet();
  const nombreHojaEditada = hojaEditada.getName();
  const filaEditada = e.range.getRow();
  const columnaEditada = e.range.getColumn();

  if (nombreHojaEditada !== nombreHojaObjetivo) return;
  if (filaEditada <= 2) return; // Ignoramos encabezados

  // Invocamos al radar para saber dónde está cada columna (0-based)
  const mapa = obtenerMapaColumnas(hojaEditada);

  // Convertimos las ubicaciones a números de columna (1-based) para getRange
  // Si por alguna razón no encuentra la columna, usa un valor por defecto para no fallar
  const colEstatus = mapa["Estatus"] !== undefined ? mapa["Estatus"] + 1 : 4;
  const colResponsable = mapa["Responsable"] !== undefined ? mapa["Responsable"] + 1 : 6;
  const colFechaIngreso = mapa["Fecha de ingreso a bitacora (m/d/a)"] !== undefined ? mapa["Fecha de ingreso a bitacora (m/d/a)"] + 1 : 3;
  const colFechaTermino = mapa["FECHA DE TÉRMINO"] !== undefined ? mapa["FECHA DE TÉRMINO"] + 1 : 7;
  const colIdTarea = mapa["ID TAREA"] !== undefined ? mapa["ID TAREA"] + 1 : 14;

  const columnasGatillo = [1, 2, colEstatus, colResponsable, 8]; 

  if (columnasGatillo.includes(columnaEditada)) {
    // --- PARTE 1: FECHA DE INGRESO AUTOMÁTICA ---
    const celdaFechaIngreso = hojaEditada.getRange(filaEditada, colFechaIngreso);
    if (celdaFechaIngreso.getValue() === "") {
      celdaFechaIngreso.setValue(new Date());
    }
   
    // --- PARTE 2: LÓGICA DE ESTATUS "CERRADO" ---
    if (columnaEditada === colEstatus) { 
      const valorNuevo = e.value ? e.value : "";
      const valorAnterior = e.oldValue ? e.oldValue : "";
      const celdaFechaTermino = hojaEditada.getRange(filaEditada, colFechaTermino); 
     
      if (valorNuevo === "Cerrado") {
        celdaFechaTermino.setValue(new Date());
      } else if (valorAnterior === "Cerrado" && valorNuevo !== "Cerrado") {
        celdaFechaTermino.clearContent(); 
      }
    }
  }

  // --- PARTE 3: CAMBIO DE RESPONSABLE ---
  if (columnaEditada === colResponsable) {
    const nombreNuevo = e.value ? e.value : "";
    const nombreAnterior = e.oldValue ? e.oldValue : "";

    // Si cambiaron al responsable, borramos el ID DE LA TAREA (ubicado dinámicamente)
    if (nombreNuevo !== nombreAnterior && nombreAnterior !== undefined) {
      const celdaIdTarea = hojaEditada.getRange(filaEditada, colIdTarea); 
      celdaIdTarea.clearContent();
    }
  }
}


